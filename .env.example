# ── Supabase (KTK CMS) ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API). .env.local is gitignored.
#
# Until these are set, the site runs on local seed data (no database needed).

# Public read credentials (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key. SERVER ONLY. Never commit, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Secret that guards the one-time seed route (POST /api/admin/seed).
# Use any long random string.
SEED_SECRET=change-me-to-a-long-random-string

# Admin login password (Phase 2, the /admin dashboard).
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string

# ── KTK website ─────────────────────────────────────────────────────────────
# Set these in Vercel (Project → Settings → Environment Variables). For local
# development, copy this file to .env.local instead — .env.local is gitignored.
#
# The website works without any of the CMS variables: it builds and serves its
# built-in content. The admin at /admin switches on once DATABASE_URL and
# PAYLOAD_SECRET are both set.

# ── CMS (required to enable editing) ────────────────────────────────────────

# Postgres connection string. Neon's free plan is enough. Use the POOLED
# connection string, and keep "?sslmode=require" on the end.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Signs admin sign-in sessions. Any long random value; changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-value

# Optional. Maximum database connections per server instance (2–10, default 3).
# Payload needs at least 2; lower values are raised to 2.
# DATABASE_POOL_MAX=3

# ── Media storage (optional) ────────────────────────────────────────────────
# Uploads are stored in the Postgres database above by default, so nothing else
# is needed. If uploads ever outgrow the database, set all four of these to move
# them to Cloudflare R2 (or any S3-compatible store) instead.
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ── Site ────────────────────────────────────────────────────────────────────

# Public canonical domain. Replace once the KTK domain points at this site.
NEXT_PUBLIC_SITE_URL=https://ktk-umber.vercel.app
